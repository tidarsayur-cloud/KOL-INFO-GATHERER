# ============================================
# KOL INFO GATHERER - Environment Variables
# Copy this file to .env and fill in values
# ============================================

# ---- KaloData API ----
KALODATA_SECRET_KEY=your_kalodata_secret_key_here

# ---- KOL.ID API ----
KOLID_API_KEY=your_kolid_api_key_here
KOLID_BASE_URL=https://api.kol.id/v1

# ---- Instagram Graph API ----
INSTAGRAM_TOKEN=your_instagram_access_token_here

# ---- TikTok Developer App ----
TIKTOK_CLIENT_KEY=your_tiktok_client_key
TIKTOK_CLIENT_SECRET=your_tiktok_client_secret

# ---- YouTube Data API v3 ----
YOUTUBE_API_KEY=your_youtube_api_key_here

# ---- Database ----
DATABASE_URL=postgresql://kol_user:kol_secret@localhost:5432/kol_analytics
POSTGRES_PASSWORD=kol_secret

# ---- Redis ----
REDIS_URL=redis://localhost:6379

# ---- App ----
NODE_ENV=development
PORT=4000
NEXT_PUBLIC_API_URL=http://localhost:4000
JWT_SECRET=your_jwt_secret_here

# ---- CORS ----
CORS_ORIGIN=http://localhost:3000
